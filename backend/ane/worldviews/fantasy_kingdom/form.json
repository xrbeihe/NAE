{
  "title": "创建你的角色",
  "fields": [
    {
      "key": "name",
      "label": "姓名",
      "kind": "text",
      "placeholder": "输入你的名字",
      "default": "",
      "maxlength": 20,
      "random_button": true,
      "store": "player.name",
      "allow_custom": true
    },
    {
      "key": "age",
      "label": "年龄",
      "kind": "number",
      "default": 19,
      "min": 12,
      "max": 999,
      "store": "attrs.age",
      "allow_custom": true
    },
    {
      "key": "gender",
      "label": "性别",
      "kind": "select",
      "options_from": "genders",
      "store": "attrs.gender"
    },
    {
      "key": "cultivation",
      "label": "能力",
      "kind": "select",
      "options_from": "cultivations",
      "hint_template": "{desc}",
      "allow_custom": true,
      "custom_label": "自定义",
      "store": "player.cultivation"
    },
    {
      "key": "identity",
      "label": "身份",
      "kind": "select",
      "options_from": "identities",
      "hint_template": "{desc}",
      "allow_custom": true,
      "store": "attrs.identity"
    },
    {
      "key": "golden_finger",
      "label": "特殊能力",
      "kind": "select",
      "options_from": "golden_fingers",
      "allow_custom": true,
      "visible_if": "has_golden_fingers",
      "option_map": {
        "id": "golden_finger_id",
        "name": "golden_finger_name",
        "tagline": "golden_finger_tagline",
        "desc": "golden_finger_desc"
      },
      "store": "attrs.golden_finger_id"
    }
  ]
}