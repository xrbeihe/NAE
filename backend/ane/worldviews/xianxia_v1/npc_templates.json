  "personalities": [
    "冷漠寡言，不喜与人来往。",
    "热情豪爽，爱结交朋友，好打抱不平。",
    "温文尔雅，谈吐得体，修养极佳。",
    "阴郁深沉，城府极深，喜怒不形于色。",
    "天真烂漫，好奇心旺盛，容易相信人。",
    "高傲自负，目中无人，但实力确实非凡。",
    "善良温柔，总是为他人着想。",
    "玩世不恭，嬉笑怒骂，实则心思缜密。",
    "偏执极端，认定的事情绝不回头。",
    "淡泊名利，与世无争，一心修炼。",
    "幽默风趣，善于化解尴尬，是人群中的开心果。",
    "谨慎多疑，对陌生人保持距离，但一旦信任便推心置腹。",
    "固执己见，不听劝告，但偶尔也能被真情打动。",
    "心思细腻，善解人意，总能察觉他人情绪变化。",
    "大智若愚，表面憨厚，实则洞若观火。"
  ],
  "core_archetypes": [
    {
      "identity": "神秘前辈",
      "personality": "深不可测，从不多言，但偶尔对后辈点出关键。",
      "cultivation": "化神期",
      "behavior_note": "独来独往，看似漫无目的地在各处游荡，实则似乎在寻找什么。"
    },
    {
      "identity": "同门挚友",
      "personality": "忠诚可靠，性格直爽，偶尔拌嘴但从不记仇。",
      "cultivation": "筑基期",
      "behavior_note": "勤奋修炼，经常主动帮同门分担杂务，人缘极好。"
    },
    {
      "identity": "敌对修士",
      "personality": "骄横跋扈，目中无人，对修为低于自己的同门尤其刻薄。",
      "cultivation": "筑基期",
      "behavior_note": "经常在宗门各处巡视，喜欢找外门弟子的麻烦立威。"
    },
    {
      "identity": "师尊",
      "personality": "严厉中藏着关怀，对弟子期望极高，但从不轻易表露赞许。",
      "cultivation": "元婴期",
      "behavior_note": "每日在洞府中打坐修炼或研读功法，偶尔去藏经阁查阅典籍。"
    },
    {
      "identity": "坊市商人",
      "personality": "精明世故，见多识广，消息灵通但真假参半。",
      "cultivation": "炼气期",
      "behavior_note": "整日在坊市里打理铺面，与各色修士打交道，消息极为灵通。"
    },
    {
      "identity": "青梅竹马",
      "personality": "温柔体贴中藏着一股倔强，外表柔弱但内心坚强。",
      "cultivation": "炼气期",
      "behavior_note": "每日除了修炼就是在后山采药或帮杂役房缝补衣物换灵石。"
    },
    {
      "identity": "宗门长老",
      "personality": "德高望重，处事公正，对宗门事务一丝不苟。",
      "cultivation": "元婴期",
      "behavior_note": "大部分时间在长老殿处理宗门事务，偶尔在演武场巡视弟子修炼。"
    },
    {
      "identity": "江湖游医",
      "personality": "古怪刁钻，喜怒无常，但医术确实高明。",
      "cultivation": "筑基期",
      "behavior_note": "背着药篓在山中各处采集药草，偶尔在坊市摆摊义诊。"
    },
    {
      "identity": "隐世高手",
      "personality": "看似普通老者，实则修为通天。豁达随和，喜欢与人闲聊但从不透露真实身份。",
      "cultivation": "渡劫期",
      "behavior_note": "整日在坊市里闲逛、喝茶、下棋，看起来像一个普通的退休老头。"
    },
    {
      "identity": "情报贩子",
      "personality": "油嘴滑舌，见人说人话见鬼说鬼话。消息灵通但真假参半，从不会做亏本买卖。",
      "cultivation": "炼气期",
      "behavior_note": "整日在聚仙楼二楼靠窗的位置喝茶，耳朵却始终竖着听各桌的谈话。"
    },
    {
      "identity": "少年弟子",
      "personality": "活泼好动，充满好奇心，对强者有天然的崇拜。嘴上没个把门，想到什么说什么。",
      "cultivation": "炼气期",
      "behavior_note": "每日在后山练剑，有空就缠着师兄师姐讲历练故事。天不怕地不怕，最喜欢探险。"
    },
    {
      "identity": "小师妹",
      "personality": "害羞内向，说话细声细气，但心思极其细腻。对信赖的人会露出依赖的一面。",
      "cultivation": "炼气期",
      "behavior_note": "不是在藏经阁看书就是在后山安静地打坐修炼，几乎从不主动与人攀谈。"
    },
