{
  "title": "创建你的角色",
  "fields": [
    {
      "key": "name",
      "label": "姓名",
      "kind": "text",
      "placeholder": "输入你的姓名",
      "default": "李明",
      "maxlength": 20,
      "random_button": true,
      "store": "player.name"
    },
    {
      "key": "age",
      "label": "年龄",
      "kind": "number",
      "default": 25,
      "min": 16,
      "max": 100,
      "store": "attrs.age"
    },
    {
      "key": "gender",
      "label": "性别",
      "kind": "select",
      "options_from": "genders",
      "store": "attrs.gender"
    },
    {
      "key": "background",
      "label": "出身背景",
      "kind": "select",
      "options_from": "backgrounds",
      "hint_template": "{desc} ｜ 初始资源：{initial_resource} ｜ 性格倾向：{personality_tendency}",
      "store": "attrs.background",
      "derive": [
        "background_summary",
        "personality_tendency"
      ]
    },
    {
      "key": "cultivation",
      "label": "职业",
      "kind": "select",
      "options_from": "cultivations",
      "hint_template": "{desc}",
      "allow_custom": true,
      "custom_label": "自定义职业描述",
      "store": "player.cultivation"
    },
    {
      "key": "personality",
      "label": "性格",
      "kind": "select",
      "options_from": "personalities",
      "hint_template": "{desc}",
      "allow_custom": true,
      "custom_label": "自定义性格描述",
      "store": "attrs.personality"
    },
    {
      "key": "identity",
      "label": "身份",
      "kind": "select",
      "options_from": "identities",
      "hint_template": "日常穿着：{clothing} ｜ {background}",
      "allow_custom": true,
      "custom_label": "自定义身份描述",
      "store": "attrs.identity",
      "derive": [
        "identity_desc",
        "clothing",
        "background_summary"
      ]
    },
    {
      "key": "golden_finger",
      "label": "天赋 / 金手指 — 你的秘密底牌",
      "kind": "card_grid",
      "options_from": "golden_fingers",
      "allow_custom": true,
      "custom_label": "自定义描写",
      "visible_if": "has_golden_fingers",
      "option_map": {
        "id": "golden_finger_id",
        "name": "golden_finger_name",
        "tagline": "golden_finger_tagline",
        "desc": "golden_finger_desc"
      },
      "store": "attrs.golden_finger_id"
    },
    {
      "key": "appearance_brief",
      "label": "外貌简述",
      "kind": "select",
      "options_from": "appearances",
      "hint_template": "{desc}",
      "allow_custom": true,
      "custom_label": "自定义外貌",
      "store": "attrs.appearance_brief",
      "pool_defaults": [
        {
          "value": "英武",
          "label": "英武不凡",
          "desc": "器宇轩昂，一看便是不凡之辈。"
        },
        {
          "value": "儒雅",
          "label": "儒雅文气",
          "desc": "举止从容，气度温和。"
        },
        {
          "value": "清秀",
          "label": "清秀温润",
          "desc": "面容清秀，气质柔和。"
        },
        {
          "value": "粗犷",
          "label": "粗犷豪迈",
          "desc": "虎背熊腰，豪爽不羁。"
        },
        {
          "value": "平凡",
          "label": "相貌平平",
          "desc": "混在人群里毫不起眼。"
        }
      ]
    }
  ]
}