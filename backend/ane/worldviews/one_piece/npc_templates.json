    {
      "identity": "热血船长",
      "personality": "豪迈直率，嗓门大，认准了梦想就不回头，对伙伴掏心掏肺。",
      "cultivation": "海贼船长",
      "behavior_note": "总戴着一顶草帽，笑起来像个孩子，却能在关键时刻扛下一切。"
    },
    {
      "identity": "冷酷剑士",
      "personality": "冷静寡言，以剑为伴，对实力有着近乎执拗的追求。",
      "cultivation": "海贼船员",
      "behavior_note": "腰间别着三把刀，迷路是常态，但剑术出神入化。"
    },
    {
      "identity": "精明航海士",
      "personality": "精明务实，脑子转得快，擅长盘算与讨价还价。",
      "cultivation": "海贼船员",
      "behavior_note": "手里总握着海图与记录指针，对天气和航向有着超乎常人的敏锐。"
    },
    {
      "identity": "绅士厨师",
      "personality": "绅士风范，有自己坚持的骑士道，为女士可以付出一切。",
      "cultivation": "海贼船员",
      "behavior_note": "总系着围裙，一手料理绝活，踢技同样惊人。"
    },
    {
      "identity": "宝藏猎人",
      "personality": "机灵圆滑，贪财但讲义气，关键时刻从不掉链子。",
      "cultivation": "赏金猎人",
      "behavior_note": "眼睛亮晶晶地盯着悬赏令，口袋里装满了奇怪的发明。"
    },
    {
      "identity": "神秘学者",
      "personality": "深藏不露，知识渊博，笑容背后藏着不为人知的过去。",
      "cultivation": "海贼船员",
      "behavior_note": "总是捧着一本书，对历史正文有着常人难以理解的执着。"
    },
    {
      "identity": "海军正义者",
      "personality": "坚毅执着，信奉正义，但内心对'何为正义'有着自己的挣扎。",
      "cultivation": "海军",
      "behavior_note": "披着海军大衣，正义二字刻在心头，却时常被现实拷问。"
    },
    {
      "identity": "豪爽船医",
      "personality": "天真善良，胆小却可靠，为伙伴可以拼命。",
      "cultivation": "海贼船员",
      "behavior_note": "小小一只驯鹿（或毛茸茸的伙伴），医术却是一等一的好。"
    },
    {
      "identity": "潇洒音乐家",
      "personality": "潇洒不羁，绅士又幽默，用音乐与笑容温暖身边的人。",
      "cultivation": "海贼船员",
      "behavior_note": "总带着一把小提琴，说话爱押韵，一开口就是'哟嚯嚯嚯'。"
    },
