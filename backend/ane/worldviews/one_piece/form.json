{
  "title": "创建你的海贼",
  "fields": [
    {
      "key": "name",
      "label": "姓名",
      "kind": "text",
      "placeholder": "输入你的海贼名",
      "default": "无名海贼",
      "maxlength": 20,
      "random_button": true,
      "store": "player.name"
    },
    {
      "key": "age",
      "label": "年龄",
      "kind": "number",
      "default": 17,
      "min": 12,
      "max": 60,
      "store": "attrs.age"
    },
    {
      "key": "gender",
      "label": "性别",
      "kind": "select",
      "options_from": "genders",
      "store": "attrs.gender"
    },
    {
      "key": "background",
      "label": "出身",
      "kind": "select",
      "options_from": "backgrounds",
      "hint_template": "{desc} ｜ 初始资源：{initial_resource}",
      "store": "attrs.background",
      "derive": [
        "background_summary"
      ]
    },
    {
      "key": "cultivation",
      "label": "身份",
      "kind": "select",
      "options_from": "cultivations",
      "hint_template": "{desc}",
      "allow_custom": true,
      "custom_label": "自定义身份",
      "store": "player.cultivation"
    },
    {
      "key": "identity",
      "label": "职位",
      "kind": "select",
      "options_from": "identities",
      "hint_template": "{desc}",
      "allow_custom": true,
      "custom_label": "自定义职位",
      "store": "attrs.identity",
      "derive": ["identity_desc", "clothing", "monthly_income"]
    },
    {
      "key": "personality",
      "label": "性格",
      "kind": "select",
      "options_from": "personalities",
      "hint_template": "{desc}",
      "allow_custom": true,
      "custom_label": "自定义性格",
      "store": "attrs.personality"
    },
    {
      "key": "golden_finger",
      "label": "恶魔果实",
      "kind": "card_grid",
      "options_from": "golden_fingers",
      "allow_custom": true,
      "visible_if": "has_golden_fingers",
      "option_map": {"id": "golden_finger_id", "name": "golden_finger_name", "tagline": "golden_finger_tagline", "desc": "golden_finger_desc"},
      "store": "attrs.golden_finger_id"
    }
  ]
}
